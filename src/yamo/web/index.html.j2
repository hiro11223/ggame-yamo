<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="googlebot" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>実況ネタ探索</title>
<link rel="stylesheet" href="style.css?v={{ version }}">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <h1>実況ネタ探索</h1>
    <p class="meta">
      更新: <time datetime="{{ generated_at }}">{{ generated_at | jst }}</time>
      ・掲載 {{ total }}件
      {% if new_count %}・<span class="new-badge">NEW</span> {{ new_count }}件{% endif %}
    </p>
    <ul class="sources" aria-label="データソースの取得状況">
      {% for s in sources %}
      <li class="source source-{{ s.status }}">
        <span aria-hidden="true">{{ s.icon }}</span> {{ s.label }}: {{ s.status_label }}（{{ s.count }}件）
        {% if s.errors or s.notes %}
        <details>
          <summary>詳細</summary>
          <ul>
            {% for e in s.errors %}<li class="error">{{ e }}</li>{% endfor %}
            {% for n in s.notes %}<li>{{ n }}</li>{% endfor %}
          </ul>
        </details>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% if stale_count %}
    <p class="notice">⚠️ 取得に失敗したソースがあるため、{{ stale_count }}件は前回のデータを表示しています。</p>
    {% endif %}
    {% if warnings %}
    <details class="warnings">
      <summary>⚠️ 警告 {{ warnings | length }}件</summary>
      <ul>{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
    </details>
    {% endif %}
  </div>
</header>

<main class="wrap">
  <nav class="tabs" role="tablist" aria-label="カテゴリ">
    {% for key, label in categories.items() %}
    <button type="button" role="tab" class="tab" data-tab="{{ key }}" aria-selected="false">
      {{ label }}<span class="count">{{ counts[key] }}</span>
    </button>
    {% endfor %}
    <button type="button" role="tab" class="tab" data-tab="all" aria-selected="false">
      全部<span class="count">{{ total }}</span>
    </button>
  </nav>

  <form class="controls" id="controls" onsubmit="return false">
    <div class="controls-row">
      <label class="control search">
        <span>検索</span>
        <input type="search" name="q" placeholder="タイトル・開発者・説明（空白区切りで AND）" autocomplete="off">
      </label>
      <label class="control">
        <span>並べ替え</span>
        <select name="sort">
          <option value="score">スコア</option>
          <option value="reviews">レビュー数</option>
          <option value="ratio">好評率</option>
          <option value="price">価格</option>
          <option value="release">発売日</option>
          <option value="title">タイトル</option>
        </select>
      </label>
      <label class="control">
        <span>順序</span>
        <select name="dir">
          <option value="desc">降順</option>
          <option value="asc">昇順</option>
        </select>
      </label>
      <button type="button" class="reset" id="reset">条件をリセット</button>
    </div>

    <div class="controls-row">
      <fieldset class="group">
        <legend>配信可否<small>（いずれか）</small></legend>
        <label class="check"><input type="checkbox" name="verdict" value="ok"> ✅ OK</label>
        <label class="check"><input type="checkbox" name="verdict" value="conditional"> ⚠️ 条件付き</label>
        <label class="check"><input type="checkbox" name="verdict" value="ng"> ❌ NG</label>
        <label class="check"><input type="checkbox" name="verdict" value="unknown"> ❓ 不明</label>
      </fieldset>
      <fieldset class="group">
        <legend>ソース<small>（いずれか）</small></legend>
        <label class="check"><input type="checkbox" name="source" value="steam"> Steam</label>
        <label class="check"><input type="checkbox" name="source" value="itch"> itch.io</label>
      </fieldset>
      <fieldset class="group">
        <legend>言語<small>（すべて対応）</small></legend>
        <label class="check"><input type="checkbox" name="lang" value="japanese"> 日本語</label>
        <label class="check"><input type="checkbox" name="lang" value="english"> 英語</label>
      </fieldset>
      <fieldset class="group">
        <legend>その他</legend>
        <label class="check"><input type="checkbox" name="demo"> デモあり</label>
        <label class="check"><input type="checkbox" name="new"> NEW のみ</label>
      </fieldset>
    </div>

    <div class="controls-row">
      <label class="control">
        <span>価格</span>
        <select name="priceMax">
          <option value="">指定なし</option>
          <option value="0">無料のみ</option>
          <option value="500">¥500 以下</option>
          <option value="1000">¥1,000 以下</option>
          <option value="1500">¥1,500 以下</option>
          <option value="2000">¥2,000 以下</option>
          <option value="3000">¥3,000 以下</option>
        </select>
      </label>
      <label class="control">
        <span>好評率</span>
        <select name="minRatio">
          <option value="">指定なし</option>
          <option value="0.7">70% 以上</option>
          <option value="0.8">80% 以上</option>
          <option value="0.9">90% 以上</option>
          <option value="0.95">95% 以上</option>
        </select>
      </label>
      <label class="control">
        <span>レビュー数（下限）</span>
        <select name="minReviews">
          <option value="">指定なし</option>
          <option value="10">10件以上</option>
          <option value="50">50件以上</option>
          <option value="100">100件以上</option>
          <option value="500">500件以上</option>
          <option value="1000">1,000件以上</option>
        </select>
      </label>
      <label class="control">
        <span>レビュー数（上限）</span>
        <select name="maxReviews">
          <option value="">指定なし</option>
          <option value="10">10件以下</option>
          <option value="30">30件以下</option>
          <option value="50">50件以下</option>
          <option value="100">100件以下</option>
          <option value="300">300件以下</option>
          <option value="1000">1,000件以下</option>
        </select>
      </label>
      <label class="control">
        <span>含むタグ</span>
        <select id="tag-add" aria-label="含むタグを追加"></select>
      </label>
      <label class="control">
        <span>タグの一致</span>
        <select name="tagMode">
          <option value="all">すべて含む</option>
          <option value="any">いずれか含む</option>
        </select>
      </label>
      <label class="control">
        <span>除外タグ</span>
        <select id="xtag-add" aria-label="除外タグを追加"></select>
      </label>
    </div>
    <div class="chips" id="tag-chips" aria-label="選択中のタグ" hidden></div>
  </form>

  <p class="result-count" id="result-count" aria-live="polite"></p>

  <div class="table-wrap">
    <table class="games" id="games">
      <thead>
        <tr>
          <th scope="col" class="c-thumb"><span class="visually-hidden">サムネイル</span></th>
          <th scope="col" class="c-title"><button type="button" data-sort="title">タイトル</button></th>
          <th scope="col" class="c-source">ソース</th>
          <th scope="col" class="c-num"><button type="button" data-sort="price">価格</button></th>
          <th scope="col" class="c-num"><button type="button" data-sort="ratio">好評率</button></th>
          <th scope="col" class="c-num"><button type="button" data-sort="reviews">レビュー数</button></th>
          <th scope="col" class="c-tags">タグ</th>
          <th scope="col" class="c-demo">デモ</th>
          <th scope="col" class="c-lang">言語</th>
          <th scope="col" class="c-stream">配信可否</th>
          <th scope="col" class="c-num"><button type="button" data-sort="score">スコア</button></th>
        </tr>
      </thead>
      <tbody id="rows"></tbody>
    </table>
  </div>
  <noscript><p class="notice">一覧の表示には JavaScript が必要です。</p></noscript>
</main>

<footer class="site-footer">
  <div class="wrap">
    <p>配信可否の自動判定は、ストアページや公式サイトの文言から推定した<strong>候補</strong>です。配信・収益化の前に、必ず公式の規約を確認してください。</p>
    <p>データ: Steam ストア / itch.io。スコアは好評率・レビュー数・新しさから算出しています（itch は別基準）。</p>
  </div>
</footer>

<script id="data" type="application/json">{{ data_json }}</script>
<script src="app.js?v={{ version }}"></script>
</body>
</html>
